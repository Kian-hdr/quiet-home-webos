{
  "name": "quiet-home",
  "version": "1.3.4",
  "private": true,
  "description": "Minimal no-root LG webOS launcher with a TV-local Home observer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "sh scripts/package.sh",
    "install:tv": "python3 tools/tv_control.py install",
    "deploy": "npm run build && npm run package",
    "manifest": "node scripts/gen-manifest.mjs",
    "assets:fetch": "python3 tools/fetch_artwork.py",
    "registration:generate": "python3 tools/generate_registration.py",
    "service:deps": "npm ci --prefix Service --omit=optional --ignore-scripts",
    "prepare:assets": "npm run assets:fetch && npm run registration:generate"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@webos-tools/cli": "^3.2.6",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "license": "MIT",
  "author": "Kian Konrad Tajbakhsh",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
